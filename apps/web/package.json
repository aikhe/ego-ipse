{
  "name": "@ego-ipse/web",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "node --run lint:js && node --run lint:css",
    "lint:css": "stylelint \"**/*.{css,svelte}\" --allow-empty-input --cache --cache-strategy=content --cache-location=.stylelintcache",
    "lint:js": "eslint \"**/*.{js,mjs,ts,svelte}\"",
    "lint:fix": "eslint \"**/*.{js,mjs,ts,svelte}\" --fix && stylelint \"**/*.{css,svelte}\" --fix",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "gen": "wrangler types"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.77",
    "@threlte/core": "^8.6.1",
    "@threlte/extras": "^9.22.3",
    "gsap": "^3.15.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@ego-ipse/eslint-config": "workspace:*",
    "@ego-ipse/stylelint-config": "workspace:*",
    "@ego-ipse/typescript-config": "workspace:*",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/three": "^0.183.1",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^2.2.1",
    "wrangler": "^4.151.3",
    "stylelint": "^17.16.0"
  }
}
