{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:turbopack": "turbo build:turbopack",
    "dev": "turbo dev",
    "dev:turbopack": "turbo dev:turbopack",
    "check": "bun run prettier; turbo lint",
    "format": "bun run prettier:fix; turbo lint:fix",
    "prettier": "prettier \"**/*.{js,mjs,ts,tsx,json,yml,css,svelte,md,html}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "bun run prettier -- --write",
    "start": "turbo start",
    "deploy": "turbo deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.11.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "devalue": "^5.9.4",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "markdown-it": "^14.3.3",
    "postcss-selector-parser": "^7.1.7",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.1",
    "vite": "^7.3.7"
  }
}
