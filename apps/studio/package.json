{
  "name": "@ego-ipse/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "check-types": "tsc --noEmit",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "format": "prettier --write .",
    "lint": "node --run lint:js",
    "lint:fix": "eslint \"**/*.{js,mjs,ts,tsx}\" --fix",
    "lint:js": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^5.31.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^5.31.2",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@ego-ipse/eslint-config": "workspace:*",
    "@ego-ipse/typescript-config": "workspace:*",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
